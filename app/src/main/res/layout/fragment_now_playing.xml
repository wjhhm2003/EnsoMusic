<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:paddingTop="6dp"
    android:paddingBottom="12dp">

    <!-- Top Centered Cover Art: Balanced adaptive height (~43%, max 154dp), 1:1 ratio, cornerRadius 16dp -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardCover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="154dp"
        app:layout_constraintHeight_percent="0.43"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_note_24" />
    </androidx.cardview.widget.CardView>

    <!-- Top Left: Lyric Shortcut Capsule (touch target >= 44dp x 30dp) -->
    <TextView
        android:id="@+id/btnLyricCapsule"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginTop="2dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_volume_capsule"
        android:gravity="center"
        android:minWidth="44dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="词"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Right: Volume Shortcut Capsule (touch target >= 48dp x 32dp) -->
    <TextView
        android:id="@+id/btnVolumeCapsule"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_volume_capsule"
        android:gravity="center"
        android:minWidth="48dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="🔊 100%" />

    <!-- Dual-Line Centered Text: 8dp below cover art, strictly centered horizontally -->
    <!-- Song Title: 18sp pure white (#FFFFFF), bold, single line marquee -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:ellipsize="marquee"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:marqueeRepeatLimit="marquee_forever"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardCover"
        tools:text="唉 (pt.3)" />

    <!-- Subtitle: 13sp cold grey (#8E8E93), format "歌手 · 专辑", single line ellipsis -->
    <TextView
        android:id="@+id/tvArtistAlbum"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="20dp"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        tools:text="张方钊, 大D(DLyn) · 唉 (pt.3)" />

    <!-- Refined Minimalist 3dp SeekBar: 28dp hitbox, 3dp thin track, 11dp thumb without clipping -->
    <SeekBar
        android:id="@+id/sbProgress"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="22dp"
        android:max="1000"
        android:maxHeight="3dp"
        android:minHeight="3dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:progressDrawable="@drawable/bg_seekbar_thin_track"
        android:splitTrack="false"
        android:thumb="@drawable/bg_seekbar_thumb"
        android:thumbOffset="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvArtistAlbum" />

    <!-- 5 Symmetric Control Buttons: Well-spaced, comfortable touch targets, vertical_bias=0.4 -->
    <!-- Left 1: btnPlayMode (touch target 46dp x 46dp, icon 24dp) -->
    <ImageView
        android:id="@+id/btnPlayMode"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginStart="14dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="播放模式"
        android:padding="11dp"
        android:src="@drawable/ic_repeat_all_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnPrevious"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sbProgress"
        app:layout_constraintVertical_bias="0.4"
        app:tint="@color/white" />

    <!-- Left 2: btnPrevious (touch target 46dp x 46dp, icon 24dp) -->
    <ImageView
        android:id="@+id/btnPrevious"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="上一首"
        android:padding="11dp"
        android:src="@drawable/ic_skip_previous_24"
        app:layout_constraintBottom_toBottomOf="@+id/btnPlayPause"
        app:layout_constraintEnd_toStartOf="@+id/btnPlayPause"
        app:layout_constraintStart_toEndOf="@+id/btnPlayMode"
        app:layout_constraintTop_toTopOf="@+id/btnPlayPause"
        app:tint="@color/white" />

    <!-- Center: btnPlayPause (54dp x 54dp Morandi green circular button @drawable/bg_circle_accent) -->
    <ImageView
        android:id="@+id/btnPlayPause"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_circle_accent"
        android:contentDescription="播放暂停"
        android:elevation="2dp"
        android:padding="13dp"
        android:src="@drawable/ic_play_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnNext"
        app:layout_constraintStart_toEndOf="@+id/btnPrevious"
        app:layout_constraintTop_toBottomOf="@+id/sbProgress"
        app:layout_constraintVertical_bias="0.4"
        app:tint="@color/white" />

    <!-- Right 2: btnNext (touch target 46dp x 46dp, icon 24dp) -->
    <ImageView
        android:id="@+id/btnNext"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="下一首"
        android:padding="11dp"
        android:src="@drawable/ic_skip_next_24"
        app:layout_constraintBottom_toBottomOf="@+id/btnPlayPause"
        app:layout_constraintEnd_toStartOf="@+id/btnQueue"
        app:layout_constraintStart_toEndOf="@+id/btnPlayPause"
        app:layout_constraintTop_toTopOf="@+id/btnPlayPause"
        app:tint="@color/white" />

    <!-- Right 1: btnQueue (touch target 46dp x 46dp, icon 24dp) -->
    <ImageView
        android:id="@+id/btnQueue"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginEnd="14dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="播放队列"
        android:padding="11dp"
        android:src="@drawable/ic_queue_music_24"
        app:layout_constraintBottom_toBottomOf="@+id/btnPlayPause"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnNext"
        app:layout_constraintTop_toTopOf="@+id/btnPlayPause"
        app:tint="@color/white" />

    <!-- Fullscreen Minimalist Lyric Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutLyricOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top Control Bar -->
        <!-- Back to Now Playing -->
        <ImageView
            android:id="@+id/btnLyricBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回播放页"
            android:padding="11dp"
            android:src="@drawable/ic_arrow_back_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <!-- Title in Lyric Header (Single Line Marquee) -->
        <TextView
            android:id="@+id/tvLyricSongTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/btnLyricBack"
            app:layout_constraintEnd_toStartOf="@+id/btnLyricRefresh"
            app:layout_constraintStart_toEndOf="@+id/btnLyricBack"
            app:layout_constraintTop_toTopOf="@+id/btnLyricBack"
            tools:text="歌曲标题" />

        <!-- Refresh / Force search online -->
        <ImageView
            android:id="@+id/btnLyricRefresh"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="重新搜索歌词"
            android:padding="11dp"
            android:src="@drawable/ic_refresh_24"
            app:layout_constraintEnd_toStartOf="@+id/btnLyricDisplayMode"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_secondary" />

        <!-- Toggle Translation & Romanization Capsule -->
        <TextView
            android:id="@+id/btnLyricDisplayMode"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_volume_capsule"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:text="译/音"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/btnLyricBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnLyricBack" />

        <!-- Lyric Custom View -->
        <com.enso.music.ui.lyric.LyricView
            android:id="@+id/lyricView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnLyricBack" />

        <!-- Empty state hint -->
        <TextView
            android:id="@+id/tvLyricEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="暂无歌词\n轻触右上角可重新在线检索"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnLyricBack" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Phase 2: Fine Volume Control Overlay (Centered Card with Dimmed Backdrop) -->
    <FrameLayout
        android:id="@+id/layoutVolumeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:elevation="10dp"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardVolumePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_volume_panel"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <!-- Title & Percentage Indicator -->
            <TextView
                android:id="@+id/tvVolumeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_green"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="精细音量 75%" />

            <!-- Row 1: Fine Volume Controls [-] [SeekBar 0..100] [+] -->
            <TextView
                android:id="@+id/btnVolMinus"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_volume_btn"
                android:gravity="center"
                android:text="－"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvVolumeTitle" />

            <SeekBar
                android:id="@+id/sbFineVolume"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:max="100"
                android:maxHeight="3dp"
                android:minHeight="3dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:progressDrawable="@drawable/bg_volume_seek_track"
                android:splitTrack="false"
                android:thumb="@drawable/bg_seekbar_thumb"
                android:thumbOffset="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/btnVolMinus"
                app:layout_constraintEnd_toStartOf="@+id/btnVolPlus"
                app:layout_constraintStart_toEndOf="@+id/btnVolMinus"
                app:layout_constraintTop_toTopOf="@+id/btnVolMinus" />

            <TextView
                android:id="@+id/btnVolPlus"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_volume_btn"
                android:gravity="center"
                android:text="＋"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvVolumeTitle" />

            <!-- Divider -->
            <View
                android:id="@+id/vVolumeDivider"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="10dp"
                android:background="@color/divider"
                app:layout_constraintTop_toBottomOf="@+id/btnVolMinus" />

            <!-- Row 2: System Base Volume Controls (AudioManager step) -->
            <LinearLayout
                android:id="@+id/layoutSystemVolume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vVolumeDivider">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="系统基准: "
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnSysVolMinus"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_volume_btn"
                    android:gravity="center"
                    android:text="-"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSystemVolumeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="10 / 15 格" />

                <TextView
                    android:id="@+id/btnSysVolPlus"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_volume_btn"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
